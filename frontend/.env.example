# SamaDerma Frontend Configuration (.env.example)
#
# Production Note:
# In Vite, variables prefixed with `VITE_` are bundled directly into the public client bundle.
# NEVER place secret tokens, private API keys, or credentials in VITE_ environment variables.

# API Base URL for the FastAPI inference backend
# Development default (loopback): http://127.0.0.1:8000
# Production example: https://api.samaderma.example.org
VITE_API_BASE_URL=http://127.0.0.1:8000
